DATABASE_URL=postgresql+psycopg://<user>:<password>@<session-pooler-host>:5432/<database>?sslmode=require
TEST_DATABASE_URL=<test-database-url>
JWT_SECRET=<replace-with-at-least-32-random-characters>
CRON_SECRET=<replace-with-an-independent-32-character-secret>
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_SECURE=true
CORS_ORIGINS=
ACTIVE_USER_DAYS=30
REGISTRATION_ENABLED=true
